{
  "Routes": [
    {
      "DownstreamPathTemplate": "/A",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        },
        {
          "Host": "localhost",
          "Port": 5002
        },
        {
          "Host": "localhost",
          "Port": 5003
        }
      ],
      "UpstreamPathTemplate": "/lb-sticky",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "LoadBalancerOptions": {
        "Type": "CookieStickySessions",
        "Key": "server_id",
        "Expiry": 30000
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5005"
  }
}